# Normalise line endings so the tree is identical on macOS, Linux and CI. Windows scripts keep
# CRLF because cmd.exe needs it.
* text=auto eol=lf
*.bat text eol=crlf

# Binaries: never diff or merge them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.heic binary
*.icns binary
*.jar binary
*.klib binary
*.wasm binary
*.mp4 binary
*.mov binary
*.xcodeproj/project.pbxproj text eol=lf
